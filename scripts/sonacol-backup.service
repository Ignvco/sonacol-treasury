[Unit]
Description=Respaldo verificable de SONACOL Treasury
After=network-online.target
[Service]
Type=oneshot
User=sonacol-sync
WorkingDirectory=/opt/sonacol-treasury
EnvironmentFile=/etc/sonacol/backup.env
ExecStart=/usr/bin/node scripts/database-backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/sonacol
ProtectHome=true
